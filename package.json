{
  "name": "ds-orchestra",
  "version": "0.1.0",
  "description": "NestJS MCP server for delegating implementation work to DeepSeek workers under enforced constraints",
  "type": "module",
  "bin": {
    "ds-orchestra-mcp": "./bin/ds-orchestra-mcp",
    "ds-orchestra": "./bin/ds-orchestra"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:mcp": "node dist/main-mcp.js",
    "start:cli": "node dist/main-cli.js",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "commander": "^12.1.0",
    "execa": "^9.2.0",
    "minimatch": "^10.0.1",
    "openai": "^4.70.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.5.0"
  }
}
